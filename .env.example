# -----------------------------------------------------------------------------
# MULTI-FILTER RULES
# -----------------------------------------------------------------------------
# Add as many numbered rules as required: FILTER_1_*, FILTER_2_*, FILTER_3_*
# Each rule has its own Discord webhook and sends one message per matching
# killmail.
#
# Region filters always narrow the rule by killmail location.
# Participant filters inspect both the victim and every attacker.
#
# PARTICIPANT_MATCH=ANY (default):
#   A participant may match the configured character OR corporation OR alliance.
#
# PARTICIPANT_MATCH=ALL:
#   The same participant must satisfy every populated participant category.
#   Example: a listed character must also belong to a listed corporation.

# Rule 1: selected characters to one webhook
FILTER_1_NAME=Tracked Pilots
FILTER_1_ENABLED=true
FILTER_1_WEBHOOK=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
FILTER_1_PARTICIPANT_MATCH=ANY
FILTER_1_CHARACTER_IDS=90783972,1906205970
FILTER_1_CHARACTER_NAMES=
FILTER_1_CORPORATION_IDS=
FILTER_1_CORPORATION_NAMES=
FILTER_1_ALLIANCE_IDS=
FILTER_1_ALLIANCE_NAMES=
FILTER_1_REGION_IDS=
FILTER_1_REGION_NAMES=

# Rule 2: every killmail in selected regions to another webhook
FILTER_2_NAME=Regional Activity
FILTER_2_ENABLED=false
FILTER_2_WEBHOOK=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
FILTER_2_PARTICIPANT_MATCH=ANY
FILTER_2_CHARACTER_IDS=
FILTER_2_CHARACTER_NAMES=
FILTER_2_CORPORATION_IDS=
FILTER_2_CORPORATION_NAMES=
FILTER_2_ALLIANCE_IDS=
FILTER_2_ALLIANCE_NAMES=
FILTER_2_REGION_IDS=
FILTER_2_REGION_NAMES=Delve,Querious

# Rule 3: selected corporation or alliance, limited to selected regions
FILTER_3_NAME=Organisation Activity
FILTER_3_ENABLED=false
FILTER_3_WEBHOOK=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
FILTER_3_PARTICIPANT_MATCH=ANY
FILTER_3_CHARACTER_IDS=
FILTER_3_CHARACTER_NAMES=
FILTER_3_CORPORATION_IDS=CORPORATION_ID
FILTER_3_CORPORATION_NAMES=
FILTER_3_ALLIANCE_IDS=ALLIANCE_ID
FILTER_3_ALLIANCE_NAMES=
FILTER_3_REGION_IDS=
FILTER_3_REGION_NAMES=Delve

# -----------------------------------------------------------------------------
# LEGACY SINGLE-WEBHOOK SETTINGS
# -----------------------------------------------------------------------------
# These are used only when no FILTER_n_WEBHOOK rules are present.
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
# WATCH_CHARACTER_IDS=90783972,1906205970
# WATCH_CHARACTER_NAMES=

# Use a descriptive, non-empty user agent for R2Z2 and ESI.
USER_AGENT=UKCorp-zKill-R2Z2-Bot/3.0 https://ukcorp.uk

# Optional ESI compatibility date. Leave blank unless deliberately pinned.
ESI_COMPATIBILITY_DATE=

# R2Z2 permits 15 requests per second. 100ms limits catch-up to 10/s.
R2Z2_SUCCESS_DELAY_MS=100

# R2Z2 requires a minimum six-second wait after reaching a missing sequence.
R2Z2_IDLE_DELAY_MS=6000

REQUEST_ERROR_DELAY_MS=15000
DEBUG=false
